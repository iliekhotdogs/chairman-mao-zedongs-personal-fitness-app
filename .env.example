# Copy this file to `.env.local` and fill in the values. `.env.local` is git-ignored.
#
# These EXPO_PUBLIC_ values are bundled INTO the app and are visible to anyone, so only
# public values go here. Secret keys (Anthropic, Supabase service role) belong ONLY in
# Supabase secrets — see docs/SETUP.md.

# Supabase project (Settings → API). Leave empty to run in "this device only" mode.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: free USDA FoodData Central key from https://fdc.nal.usda.gov/api-key-signup
# (not secret; DEMO_KEY is used when empty and is heavily rate-limited)
EXPO_PUBLIC_USDA_API_KEY=
