# Copy to .env.local. Only public project values belong here; .env.local is git-ignored.
# Private keys are Supabase Edge Function secrets, never Expo env vars:
#   GROQ_API_KEY, GEMINI_API_KEY, NVIDIA_API_KEY (AI providers; set the ones you use)
#   FDC_API_KEY (USDA), ADMIN_USER_ID (bootstrap admin), ALLOWED_ORIGINS (CORS)
# See docs/SETUP.md.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: USDA FoodData Central key for manual food search on the device.
EXPO_PUBLIC_USDA_API_KEY=
