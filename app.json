{
  "expo": {
    "name": "FitCoach",
    "slug": "fitcoach",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fitcoach",
    "description": "FitCoach: photo food logging, adaptive training plans and a coach that asks before it changes anything.",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0B0D",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0B0D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fitcoach.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro",
      "name": "FitCoach: train, eat, get better",
      "shortName": "FitCoach",
      "description": "FitCoach: photo food logging, adaptive training plans and a coach that asks before it changes anything.",
      "lang": "en",
      "themeColor": "#0A0B0D",
      "backgroundColor": "#0A0B0D"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0B0D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FitCoach to use your photos to log meals and save progress photos.",
          "cameraPermission": "Allow FitCoach to use the camera to photograph meals and take progress photos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow FitCoach to use the camera to scan food barcodes and photograph meals.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D4FF3A"
        }
      ],
      "expo-secure-store",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
